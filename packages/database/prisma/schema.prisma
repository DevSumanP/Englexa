generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  message   String
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model QuoteRequest {
  id          String     @id @default(cuid())
  name        String
  email       String
  phone       String
  service     String
  description String
  budget      String?
  status      LeadStatus @default(NEW)
  createdAt   DateTime   @default(now())
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}
